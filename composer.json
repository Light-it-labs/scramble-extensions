{
    "name": "light-it/scramble-extensions",
    "autoload": {
        "psr-4": {
            "LightIt\\ScrambleExtensions\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Agustin Fernandez",
            "email": "agustin.fernandez@lightit.io"
        }
    ],
    "require": {
        "dedoc/scramble": "^0.11",
        "php": "^8.1",
        "flugger/laravel-responder": "^3.3",
        "illuminate/contracts": "^10.0|^11.0",
        "league/fractal": "^0.20.1",
        "nikic/php-parser": "^5.0",
        "phpstan/phpdoc-parser": "^1.0",
        "spatie/laravel-package-tools": "^1.9.2"
    },
    "require-dev": {
        "doctrine/dbal": "^3.4|^4.0",
        "laravel/pint": "^v1.1.0",
        "nunomaduro/collision": "^v8.0",
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "^11.0",
        "spatie/pest-plugin-snapshots": "^2.2"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}